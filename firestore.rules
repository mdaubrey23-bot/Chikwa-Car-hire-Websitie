rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "Dumisani777@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Car rules
    match /cars/{carId} {
      allow read: if true; // Publicly viewable
      allow create, update, delete: if isAdmin();
      
      function isValidCar(data) {
        return data.name is string && data.name.size() > 0 &&
               data.category in ['Economy', 'SUV', 'Luxury', 'Van', 'Truck'] &&
               data.pricePerDay is number && data.pricePerDay > 0 &&
               data.image is string && data.image.size() > 0;
      }
    }

    // Quote rules
    match /quotes/{quoteId} {
      allow create: if true; // Anyone can request a quote
      allow read, list: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
    }

    // Admin rules
    match /admins/{adminId} {
      allow read: if isSignedIn();
    }
  }
}
